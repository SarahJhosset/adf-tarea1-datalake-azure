{
	"name": "df_ventas_online_bronze_silver",
	"properties": {
		"folder": {
			"name": "Bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Ventas_online_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "derivedColumn4"
				}
			],
			"scriptLines": [
				"source(output(",
				"          order_id as string,",
				"          timestamp as string,",
				"          product as string,",
				"          qty as string,",
				"          unit_price as string,",
				"          {customer/name} as string,",
				"          {customer/email} as string,",
				"          {customer/city} as string,",
				"          payment_method as string,",
				"          status as string,",
				"          shipping_cost as string,",
				"          channel as string,",
				"          customer as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 select(mapColumn(",
				"          id_orden = order_id,",
				"          fecha = timestamp,",
				"          producto = product,",
				"          cantidad = qty,",
				"          precio_unitario = unit_price,",
				"          nombre_cliente = {customer/name},",
				"          cliente_email = {customer/email},",
				"          cliente_ciudad = {customer/city},",
				"          metodo_pago = payment_method,",
				"          estatus = status,",
				"          costo_envio = shipping_cost,",
				"          canal = channel,",
				"          cliente = customer",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 derive(id_orden = trim(id_orden),",
				"          fecha = trim(fecha),",
				"          producto = trim(producto),",
				"          cantidad = trim(cantidad),",
				"          precio_unitario = trim(precio_unitario),",
				"          nombre_cliente = trim(nombre_cliente),",
				"          cliente_email = trim(cliente_email),",
				"          cliente_ciudad = trim(cliente_ciudad),",
				"          metodo_pago = trim(metodo_pago),",
				"          estatus = trim(estatus),",
				"          costo_envio = trim(costo_envio),",
				"          cliente = trim(cliente)) ~> derivedColumn1",
				"derivedColumn1 derive(producto = initCap(regexReplace(producto, '\\\\s+', ' '))) ~> derivedColumn2",
				"derivedColumn2 derive(cliente_ciudad = case(\r",
				"    in(['lp','lpz','la paz','lapaz','l.p.'], lower(trim(cliente_ciudad))), 'La Paz',\r",
				"    in(['scz','sc','santa cruz','sta cruz','sta. cruz','santa cruz de la sierra'], lower(trim(cliente_ciudad))), 'Santa Cruz',\r",
				"    in(['cbba','cochabamba','cocha'], lower(trim(cliente_ciudad))), 'Cochabamba',\r",
				"    in(['oruro'], lower(trim(cliente_ciudad))), 'Oruro',\r",
				"    in(['potosi','potosí','pts'], lower(trim(cliente_ciudad))), 'Potosí',\r",
				"    in(['tarija','tja'], lower(trim(cliente_ciudad))), 'Tarija',\r",
				"    in(['sucre','chuquisaca','chq'], lower(trim(cliente_ciudad))), 'Sucre',\r",
				"    in(['cobija','pando'], lower(trim(cliente_ciudad))), 'Cobija',\r",
				"    in(['trinidad','beni'], lower(trim(cliente_ciudad))), 'Trinidad',\r",
				"    'Desconocido'\r",
				")) ~> derivedColumn3",
				"derivedColumn3 derive(cantidad = toInteger(cantidad),",
				"          precio_unitario = toFloat(regexReplace(toString(precio_unitario), '[^0-9.]', ''))) ~> derivedColumn4"
			]
		}
	}
}